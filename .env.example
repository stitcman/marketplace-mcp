# Required for API key encryption (32 bytes hex): openssl rand -hex 32
MASTER_KEY=

# PostgreSQL. If unset, the server starts with an in-memory store
# (demo mode with mock seller accounts for all three marketplaces).
# DATABASE_URL=postgres://mcp:mcp_dev_password@localhost:5432/marketplace_mcp

# --- HTTP transport (only used with --http) ---
# Bearer token for POST /mcp. Without it the server binds to 127.0.0.1 ONLY,
# because these tools sit in front of real seller-account keys.
# Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Comma-separated allowed Origins (DNS-rebinding protection for browsers).
# Requests without an Origin header (ordinary MCP clients) always pass.
# MCP_ALLOWED_ORIGINS=https://app.example.com

# PORT=3000
# HOST=0.0.0.0   # only honoured when MCP_AUTH_TOKEN is set

# --- Quick way to attach real seller accounts without a database (demo) ---
# Without these variables, mock accounts are seeded for all three marketplaces.

# Wildberries: token from the seller cabinet -> Settings -> API access.
# Required categories (read-only is enough): Content, Analytics, Statistics,
# Prices and discounts.
# WB_API_TOKEN=
# WB_CONNECTION_NAME=My Wildberries account
# WB sandbox: its token is created in the cabinet separately from the production one.
# Note: the Analytics category has no sandbox, so wb_stocks_get still reads the
# production account in this mode (read-only, nothing is modified).
# WB_SANDBOX=1

# Ozon: Client-Id and Api-Key from the seller cabinet -> Settings -> Seller API.
# OZON_CLIENT_ID=
# OZON_API_KEY=
# OZON_CONNECTION_NAME=My Ozon account

# Yandex Market: Api-Key from the cabinet -> API modules -> Authorization tokens.
# Needs the offers-and-cards-management:read-only and
# inventory-and-order-processing:read-only scopes.
# business_id may be omitted — it is resolved automatically when there is only one.
# YM_API_KEY=
# YM_BUSINESS_ID=
# YM_CONNECTION_NAME=My Yandex Market account
