{
  "name": "marketplace-mcp",
  "version": "0.4.0",
  "description": "MCP server for Wildberries / Ozon / Yandex Market seller cabinets (read-only, multi-account)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "tsx test/runtime-identity.test.ts && tsx test/startup-order.test.ts && tsx test/runtime-identity-tool.test.ts && tsx test/tool-visibility.test.ts && tsx test/read-policy.test.ts && tsx test/ozon-parity.test.ts && tsx test/smoke.test.ts",
    "test:real:preflight": "tsx test/real/preflight.test.ts",
    "test:real": "tsx test/real/read-e2e.ts",
    "baseline:generate": "tsx scripts/generate-marketplace-passport.mjs",
    "baseline:check": "tsx scripts/generate-marketplace-passport.mjs --check",
    "policies:generate": "node scripts/generate-read-policies.mjs",
    "policies:check": "tsx test/policy-inventory.test.ts",
    "policies:diff": "node scripts/check-policy-updates.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.13.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
